// Schema do banco de dados da plataforma ELLA.
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("usuaria")
  avatar    String   @default("avatar-1")
  nickname  String?
  bio       String?  @db.Text
  city      String?
  phone     String?
  createdAt DateTime @default(now())
}
