// Schema do banco de dados da plataforma ELLA.
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String?
  password     String?
  role         String        @default("usuaria")
  accountType  String        @default("usuaria")
  crm          String?
  avatar       String        @default("avatar-1")
  photo        String?       @db.LongText
  nickname     String?
  bio          String?       @db.Text
  city         String?
  phone        String?
  areasAtuacao String?       @db.Text
  createdAt    DateTime      @default(now())
  messages     ChatMessage[]
}

// Mensagens salvas localmente pelo próprio usuário.
// Cada registro pertence apenas a quem o criou: não há entrega em tempo real
// nem compartilhamento entre contas.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  chat      String   @default("usuaria")
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, chat])
}

// Cards da Rede de Apoio exibidos em /apoio e administrados pelo painel.
// Cada card tem sua própria página de detalhes (/apoio/:id).
model SupportNetwork {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  category    String?  @db.VarChar(80)
  description String   @db.VarChar(600)
  details     String?  @db.VarChar(600)
  website     String?  @db.VarChar(500)
  phone       String?  @db.VarChar(40)
  image       String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Registro dos acionamentos do botão de emergência (ligação para o 190).
model EmergencyCall {
  id        Int      @id @default(autoincrement())
  type      String   @default("ligacao_policial")
  createdAt DateTime @default(now())
}
