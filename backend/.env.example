# Copie este arquivo para .env e preencha com os dados do seu MySQL.
# O arquivo .env não deve ser versionado.

PORT=5000
NODE_ENV=development

# Conexão usada pelo driver adapter (src/lib/prisma.js)
DB_USER="root"
DB_PASSWORD="sua_senha"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="ella_db"

# Conexão usada pelo Prisma CLI (migrações e Prisma Studio)
DATABASE_URL="mysql://root:sua_senha@localhost:3306/ella_db"

# JWT
JWT_SECRET="troque-por-uma-chave-segura-e-longa"
JWT_EXPIRES_IN="1h"
